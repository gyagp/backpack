// @meta noregistry=true
// Same 32x8/K32 output tile as accepted staged prefill. Each of 128 threads
// keeps separate original 32-partial sums for two adjacent output columns.
@group(0) @binding(0) var<storage,read> X:array<u32>;
@group(0) @binding(1) var<storage,read> W:array<u32>;
@group(0) @binding(2) var<storage,read> Bias:array<f32>;
@group(0) @binding(3) var<storage,read_write> Y:array<f32>;
@group(0) @binding(4) var<storage,read> P:array<u32>;
var<workgroup> tileA:array<f32,1056>;
var<workgroup> tileB:array<f32,288>;
@compute @workgroup_size(128)
fn main(@builtin(local_invocation_id) lid:vec3<u32>,@builtin(workgroup_id) wid:vec3<u32>) {
    let K=P[0];let N=P[7];let M=P[6];let tid=lid.x;
    let lm=tid/4u;let ln=(tid%4u)*2u;
    let row=wid.x*32u+lm;let col=wid.y*8u+ln;
    var acc0:array<f32,32>;var acc1:array<f32,32>;
    for(var k0=0u;k0<K;k0+=32u) {
        for(var i=tid;i<1024u;i+=128u) {
            let r=i/32u;let k=i%32u;var a=0.0;
            if(wid.x*32u+r<M && k0+k<K) {a=bitcast<f32>(X[(wid.x*32u+r)*K+k0+k]);}
            tileA[r*33u+k]=a;
        }
        for(var i=tid;i<256u;i+=128u) {
            let r=i/32u;let k=i%32u;var b=0.0;
            if(wid.y*8u+r<N && k0+k<K) {b=bitcast<f32>(W[(wid.y*8u+r)*K+k0+k]);}
            tileB[k*9u+r]=b;
        }
        workgroupBarrier();
        let a0=tileA[lm*33u+0u];
        acc0[0]+=a0*tileB[0u*9u+ln];
        acc1[0]+=a0*tileB[0u*9u+ln+1u];
        let a1=tileA[lm*33u+1u];
        acc0[1]+=a1*tileB[1u*9u+ln];
        acc1[1]+=a1*tileB[1u*9u+ln+1u];
        let a2=tileA[lm*33u+2u];
        acc0[2]+=a2*tileB[2u*9u+ln];
        acc1[2]+=a2*tileB[2u*9u+ln+1u];
        let a3=tileA[lm*33u+3u];
        acc0[3]+=a3*tileB[3u*9u+ln];
        acc1[3]+=a3*tileB[3u*9u+ln+1u];
        let a4=tileA[lm*33u+4u];
        acc0[4]+=a4*tileB[4u*9u+ln];
        acc1[4]+=a4*tileB[4u*9u+ln+1u];
        let a5=tileA[lm*33u+5u];
        acc0[5]+=a5*tileB[5u*9u+ln];
        acc1[5]+=a5*tileB[5u*9u+ln+1u];
        let a6=tileA[lm*33u+6u];
        acc0[6]+=a6*tileB[6u*9u+ln];
        acc1[6]+=a6*tileB[6u*9u+ln+1u];
        let a7=tileA[lm*33u+7u];
        acc0[7]+=a7*tileB[7u*9u+ln];
        acc1[7]+=a7*tileB[7u*9u+ln+1u];
        let a8=tileA[lm*33u+8u];
        acc0[8]+=a8*tileB[8u*9u+ln];
        acc1[8]+=a8*tileB[8u*9u+ln+1u];
        let a9=tileA[lm*33u+9u];
        acc0[9]+=a9*tileB[9u*9u+ln];
        acc1[9]+=a9*tileB[9u*9u+ln+1u];
        let a10=tileA[lm*33u+10u];
        acc0[10]+=a10*tileB[10u*9u+ln];
        acc1[10]+=a10*tileB[10u*9u+ln+1u];
        let a11=tileA[lm*33u+11u];
        acc0[11]+=a11*tileB[11u*9u+ln];
        acc1[11]+=a11*tileB[11u*9u+ln+1u];
        let a12=tileA[lm*33u+12u];
        acc0[12]+=a12*tileB[12u*9u+ln];
        acc1[12]+=a12*tileB[12u*9u+ln+1u];
        let a13=tileA[lm*33u+13u];
        acc0[13]+=a13*tileB[13u*9u+ln];
        acc1[13]+=a13*tileB[13u*9u+ln+1u];
        let a14=tileA[lm*33u+14u];
        acc0[14]+=a14*tileB[14u*9u+ln];
        acc1[14]+=a14*tileB[14u*9u+ln+1u];
        let a15=tileA[lm*33u+15u];
        acc0[15]+=a15*tileB[15u*9u+ln];
        acc1[15]+=a15*tileB[15u*9u+ln+1u];
        let a16=tileA[lm*33u+16u];
        acc0[16]+=a16*tileB[16u*9u+ln];
        acc1[16]+=a16*tileB[16u*9u+ln+1u];
        let a17=tileA[lm*33u+17u];
        acc0[17]+=a17*tileB[17u*9u+ln];
        acc1[17]+=a17*tileB[17u*9u+ln+1u];
        let a18=tileA[lm*33u+18u];
        acc0[18]+=a18*tileB[18u*9u+ln];
        acc1[18]+=a18*tileB[18u*9u+ln+1u];
        let a19=tileA[lm*33u+19u];
        acc0[19]+=a19*tileB[19u*9u+ln];
        acc1[19]+=a19*tileB[19u*9u+ln+1u];
        let a20=tileA[lm*33u+20u];
        acc0[20]+=a20*tileB[20u*9u+ln];
        acc1[20]+=a20*tileB[20u*9u+ln+1u];
        let a21=tileA[lm*33u+21u];
        acc0[21]+=a21*tileB[21u*9u+ln];
        acc1[21]+=a21*tileB[21u*9u+ln+1u];
        let a22=tileA[lm*33u+22u];
        acc0[22]+=a22*tileB[22u*9u+ln];
        acc1[22]+=a22*tileB[22u*9u+ln+1u];
        let a23=tileA[lm*33u+23u];
        acc0[23]+=a23*tileB[23u*9u+ln];
        acc1[23]+=a23*tileB[23u*9u+ln+1u];
        let a24=tileA[lm*33u+24u];
        acc0[24]+=a24*tileB[24u*9u+ln];
        acc1[24]+=a24*tileB[24u*9u+ln+1u];
        let a25=tileA[lm*33u+25u];
        acc0[25]+=a25*tileB[25u*9u+ln];
        acc1[25]+=a25*tileB[25u*9u+ln+1u];
        let a26=tileA[lm*33u+26u];
        acc0[26]+=a26*tileB[26u*9u+ln];
        acc1[26]+=a26*tileB[26u*9u+ln+1u];
        let a27=tileA[lm*33u+27u];
        acc0[27]+=a27*tileB[27u*9u+ln];
        acc1[27]+=a27*tileB[27u*9u+ln+1u];
        let a28=tileA[lm*33u+28u];
        acc0[28]+=a28*tileB[28u*9u+ln];
        acc1[28]+=a28*tileB[28u*9u+ln+1u];
        let a29=tileA[lm*33u+29u];
        acc0[29]+=a29*tileB[29u*9u+ln];
        acc1[29]+=a29*tileB[29u*9u+ln+1u];
        let a30=tileA[lm*33u+30u];
        acc0[30]+=a30*tileB[30u*9u+ln];
        acc1[30]+=a30*tileB[30u*9u+ln+1u];
        let a31=tileA[lm*33u+31u];
        acc0[31]+=a31*tileB[31u*9u+ln];
        acc1[31]+=a31*tileB[31u*9u+ln+1u];
        workgroupBarrier();
    }
    acc0[0]+=acc0[16];
    acc1[0]+=acc1[16];
    acc0[1]+=acc0[17];
    acc1[1]+=acc1[17];
    acc0[2]+=acc0[18];
    acc1[2]+=acc1[18];
    acc0[3]+=acc0[19];
    acc1[3]+=acc1[19];
    acc0[4]+=acc0[20];
    acc1[4]+=acc1[20];
    acc0[5]+=acc0[21];
    acc1[5]+=acc1[21];
    acc0[6]+=acc0[22];
    acc1[6]+=acc1[22];
    acc0[7]+=acc0[23];
    acc1[7]+=acc1[23];
    acc0[8]+=acc0[24];
    acc1[8]+=acc1[24];
    acc0[9]+=acc0[25];
    acc1[9]+=acc1[25];
    acc0[10]+=acc0[26];
    acc1[10]+=acc1[26];
    acc0[11]+=acc0[27];
    acc1[11]+=acc1[27];
    acc0[12]+=acc0[28];
    acc1[12]+=acc1[28];
    acc0[13]+=acc0[29];
    acc1[13]+=acc1[29];
    acc0[14]+=acc0[30];
    acc1[14]+=acc1[30];
    acc0[15]+=acc0[31];
    acc1[15]+=acc1[31];
    acc0[0]+=acc0[8];
    acc1[0]+=acc1[8];
    acc0[1]+=acc0[9];
    acc1[1]+=acc1[9];
    acc0[2]+=acc0[10];
    acc1[2]+=acc1[10];
    acc0[3]+=acc0[11];
    acc1[3]+=acc1[11];
    acc0[4]+=acc0[12];
    acc1[4]+=acc1[12];
    acc0[5]+=acc0[13];
    acc1[5]+=acc1[13];
    acc0[6]+=acc0[14];
    acc1[6]+=acc1[14];
    acc0[7]+=acc0[15];
    acc1[7]+=acc1[15];
    acc0[0]+=acc0[4];
    acc1[0]+=acc1[4];
    acc0[1]+=acc0[5];
    acc1[1]+=acc1[5];
    acc0[2]+=acc0[6];
    acc1[2]+=acc1[6];
    acc0[3]+=acc0[7];
    acc1[3]+=acc1[7];
    acc0[0]+=acc0[2];
    acc1[0]+=acc1[2];
    acc0[1]+=acc0[3];
    acc1[1]+=acc1[3];
    acc0[0]+=acc0[1];
    acc1[0]+=acc1[1];
    var stride=N;if(P[5]!=0u){stride=P[5];}
    if(row<M && col<N){Y[row*stride+col+P[8]]=acc0[0]+Bias[col+P[4]];}
    if(row<M && col+1u<N){Y[row*stride+col+1u+P[8]]=acc1[0]+Bias[col+1u+P[4]];}
}
