// @meta noregistry=true
// Same 32x8/K32 output tile as accepted staged prefill. Each of 128 threads
// keeps separate original 32-partial sums for two adjacent output columns.
@group(0) @binding(0) var<storage,read> X:array<u32>;
@group(0) @binding(1) var<storage,read> W:array<u32>;
@group(0) @binding(2) var<storage,read> Bias:array<f32>;
@group(0) @binding(3) var<storage,read_write> Y:array<f32>;
@group(0) @binding(4) var<storage,read> P:array<u32>;
var<workgroup> tileA:array<f32,1152>;
var<workgroup> tileB:array<vec2<f32>,160>;
@compute @workgroup_size(128)
fn main(@builtin(local_invocation_id) lid:vec3<u32>,@builtin(workgroup_id) wid:vec3<u32>) {
    let K=P[0];let N=P[7];let M=P[6];let tid=lid.x;
    let lm=tid/4u;let ln=(tid%4u)*2u;
    let row=wid.x*32u+lm;let col=wid.y*8u+ln;
    var acc0:array<f32,32>;var acc1:array<f32,32>;
    for(var k0=0u;k0<K;k0+=32u) {
        for(var i=tid;i<1024u;i+=128u) {
            let r=i/32u;let k=i%32u;var a=0.0;
            if(wid.x*32u+r<M && k0+k<K) {a=bitcast<f32>(X[(wid.x*32u+r)*K+k0+k]);}
            tileA[r*36u+k]=a;
        }
        // Keep the original128 complete-pair writers. Pair-major rows
        // align each even-K two-pair span to16 bytes without growing storage.
        let br=(tid/32u)*2u;let bk=tid%32u;
        var loadedB0=0.0;var loadedB1=0.0;
        if(wid.y*8u+br<N && k0+bk<K) {loadedB0=bitcast<f32>(W[(wid.y*8u+br)*K+k0+bk]);}
        if(wid.y*8u+br+1u<N && k0+bk<K) {loadedB1=bitcast<f32>(W[(wid.y*8u+br+1u)*K+k0+bk]);}
        tileB[(br/2u)*34u+bk]=vec2<f32>(loadedB0,loadedB1);
        workgroupBarrier();
        let a0=tileA[lm*36u+0u];
        let b0=tileB[(ln/2u)*34u+0u];
        acc0[0]+=a0*b0.x;
        acc1[0]+=a0*b0.y;
        let a1=tileA[lm*36u+1u];
        let b1=tileB[(ln/2u)*34u+1u];
        acc0[1]+=a1*b1.x;
        acc1[1]+=a1*b1.y;
        let a2=tileA[lm*36u+2u];
        let b2=tileB[(ln/2u)*34u+2u];
        acc0[2]+=a2*b2.x;
        acc1[2]+=a2*b2.y;
        let a3=tileA[lm*36u+3u];
        let b3=tileB[(ln/2u)*34u+3u];
        acc0[3]+=a3*b3.x;
        acc1[3]+=a3*b3.y;
        let a4=tileA[lm*36u+4u];
        let b4=tileB[(ln/2u)*34u+4u];
        acc0[4]+=a4*b4.x;
        acc1[4]+=a4*b4.y;
        let a5=tileA[lm*36u+5u];
        let b5=tileB[(ln/2u)*34u+5u];
        acc0[5]+=a5*b5.x;
        acc1[5]+=a5*b5.y;
        let a6=tileA[lm*36u+6u];
        let b6=tileB[(ln/2u)*34u+6u];
        acc0[6]+=a6*b6.x;
        acc1[6]+=a6*b6.y;
        let a7=tileA[lm*36u+7u];
        let b7=tileB[(ln/2u)*34u+7u];
        acc0[7]+=a7*b7.x;
        acc1[7]+=a7*b7.y;
        let a8=tileA[lm*36u+8u];
        let b8=tileB[(ln/2u)*34u+8u];
        acc0[8]+=a8*b8.x;
        acc1[8]+=a8*b8.y;
        let a9=tileA[lm*36u+9u];
        let b9=tileB[(ln/2u)*34u+9u];
        acc0[9]+=a9*b9.x;
        acc1[9]+=a9*b9.y;
        let a10=tileA[lm*36u+10u];
        let b10=tileB[(ln/2u)*34u+10u];
        acc0[10]+=a10*b10.x;
        acc1[10]+=a10*b10.y;
        let a11=tileA[lm*36u+11u];
        let b11=tileB[(ln/2u)*34u+11u];
        acc0[11]+=a11*b11.x;
        acc1[11]+=a11*b11.y;
        let a12=tileA[lm*36u+12u];
        let b12=tileB[(ln/2u)*34u+12u];
        acc0[12]+=a12*b12.x;
        acc1[12]+=a12*b12.y;
        let a13=tileA[lm*36u+13u];
        let b13=tileB[(ln/2u)*34u+13u];
        acc0[13]+=a13*b13.x;
        acc1[13]+=a13*b13.y;
        let a14=tileA[lm*36u+14u];
        let b14=tileB[(ln/2u)*34u+14u];
        acc0[14]+=a14*b14.x;
        acc1[14]+=a14*b14.y;
        let a15=tileA[lm*36u+15u];
        let b15=tileB[(ln/2u)*34u+15u];
        acc0[15]+=a15*b15.x;
        acc1[15]+=a15*b15.y;
        let a16=tileA[lm*36u+16u];
        let b16=tileB[(ln/2u)*34u+16u];
        acc0[16]+=a16*b16.x;
        acc1[16]+=a16*b16.y;
        let a17=tileA[lm*36u+17u];
        let b17=tileB[(ln/2u)*34u+17u];
        acc0[17]+=a17*b17.x;
        acc1[17]+=a17*b17.y;
        let a18=tileA[lm*36u+18u];
        let b18=tileB[(ln/2u)*34u+18u];
        acc0[18]+=a18*b18.x;
        acc1[18]+=a18*b18.y;
        let a19=tileA[lm*36u+19u];
        let b19=tileB[(ln/2u)*34u+19u];
        acc0[19]+=a19*b19.x;
        acc1[19]+=a19*b19.y;
        let a20=tileA[lm*36u+20u];
        let b20=tileB[(ln/2u)*34u+20u];
        acc0[20]+=a20*b20.x;
        acc1[20]+=a20*b20.y;
        let a21=tileA[lm*36u+21u];
        let b21=tileB[(ln/2u)*34u+21u];
        acc0[21]+=a21*b21.x;
        acc1[21]+=a21*b21.y;
        let a22=tileA[lm*36u+22u];
        let b22=tileB[(ln/2u)*34u+22u];
        acc0[22]+=a22*b22.x;
        acc1[22]+=a22*b22.y;
        let a23=tileA[lm*36u+23u];
        let b23=tileB[(ln/2u)*34u+23u];
        acc0[23]+=a23*b23.x;
        acc1[23]+=a23*b23.y;
        let a24=tileA[lm*36u+24u];
        let b24=tileB[(ln/2u)*34u+24u];
        acc0[24]+=a24*b24.x;
        acc1[24]+=a24*b24.y;
        let a25=tileA[lm*36u+25u];
        let b25=tileB[(ln/2u)*34u+25u];
        acc0[25]+=a25*b25.x;
        acc1[25]+=a25*b25.y;
        let a26=tileA[lm*36u+26u];
        let b26=tileB[(ln/2u)*34u+26u];
        acc0[26]+=a26*b26.x;
        acc1[26]+=a26*b26.y;
        let a27=tileA[lm*36u+27u];
        let b27=tileB[(ln/2u)*34u+27u];
        acc0[27]+=a27*b27.x;
        acc1[27]+=a27*b27.y;
        let a28=tileA[lm*36u+28u];
        let b28=tileB[(ln/2u)*34u+28u];
        acc0[28]+=a28*b28.x;
        acc1[28]+=a28*b28.y;
        let a29=tileA[lm*36u+29u];
        let b29=tileB[(ln/2u)*34u+29u];
        acc0[29]+=a29*b29.x;
        acc1[29]+=a29*b29.y;
        let a30=tileA[lm*36u+30u];
        let b30=tileB[(ln/2u)*34u+30u];
        acc0[30]+=a30*b30.x;
        acc1[30]+=a30*b30.y;
        let a31=tileA[lm*36u+31u];
        let b31=tileB[(ln/2u)*34u+31u];
        acc0[31]+=a31*b31.x;
        acc1[31]+=a31*b31.y;
        workgroupBarrier();
    }
    acc0[0]+=acc0[16];
    acc1[0]+=acc1[16];
    acc0[1]+=acc0[17];
    acc1[1]+=acc1[17];
    acc0[2]+=acc0[18];
    acc1[2]+=acc1[18];
    acc0[3]+=acc0[19];
    acc1[3]+=acc1[19];
    acc0[4]+=acc0[20];
    acc1[4]+=acc1[20];
    acc0[5]+=acc0[21];
    acc1[5]+=acc1[21];
    acc0[6]+=acc0[22];
    acc1[6]+=acc1[22];
    acc0[7]+=acc0[23];
    acc1[7]+=acc1[23];
    acc0[8]+=acc0[24];
    acc1[8]+=acc1[24];
    acc0[9]+=acc0[25];
    acc1[9]+=acc1[25];
    acc0[10]+=acc0[26];
    acc1[10]+=acc1[26];
    acc0[11]+=acc0[27];
    acc1[11]+=acc1[27];
    acc0[12]+=acc0[28];
    acc1[12]+=acc1[28];
    acc0[13]+=acc0[29];
    acc1[13]+=acc1[29];
    acc0[14]+=acc0[30];
    acc1[14]+=acc1[30];
    acc0[15]+=acc0[31];
    acc1[15]+=acc1[31];
    acc0[0]+=acc0[8];
    acc1[0]+=acc1[8];
    acc0[1]+=acc0[9];
    acc1[1]+=acc1[9];
    acc0[2]+=acc0[10];
    acc1[2]+=acc1[10];
    acc0[3]+=acc0[11];
    acc1[3]+=acc1[11];
    acc0[4]+=acc0[12];
    acc1[4]+=acc1[12];
    acc0[5]+=acc0[13];
    acc1[5]+=acc1[13];
    acc0[6]+=acc0[14];
    acc1[6]+=acc1[14];
    acc0[7]+=acc0[15];
    acc1[7]+=acc1[15];
    acc0[0]+=acc0[4];
    acc1[0]+=acc1[4];
    acc0[1]+=acc0[5];
    acc1[1]+=acc1[5];
    acc0[2]+=acc0[6];
    acc1[2]+=acc1[6];
    acc0[3]+=acc0[7];
    acc1[3]+=acc1[7];
    acc0[0]+=acc0[2];
    acc1[0]+=acc1[2];
    acc0[1]+=acc0[3];
    acc1[1]+=acc1[3];
    acc0[0]+=acc0[1];
    acc1[0]+=acc1[1];
    var stride=N;if(P[5]!=0u){stride=P[5];}
    if(row<M && col<N){Y[row*stride+col+P[8]]=acc0[0]+Bias[col+P[4]];}
    if(row<M && col+1u<N){Y[row*stride+col+1u+P[8]]=acc1[0]+Bias[col+1u+P[4]];}
}
